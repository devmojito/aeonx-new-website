# Copy to .env and adjust. Nothing here is read from anywhere else --
# the same image runs locally and on AWS with only this file differing.

# ---- Django
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,api
DJANGO_TIME_ZONE=Asia/Kolkata
# Production only: scheme-qualified origins that POST to the admin
# DJANGO_CSRF_TRUSTED_ORIGINS=https://admin.aeonx.digital

# ---- Postgres
POSTGRES_DB=aeonx
POSTGRES_USER=aeonx
POSTGRES_PASSWORD=aeonx
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Object storage
# Local: MinIO. Production: delete AWS_S3_ENDPOINT_URL and AWS_S3_PATH_STYLE,
# then use a real bucket + an IAM role on the instance (no keys in the file).
USE_S3=true
AWS_ACCESS_KEY_ID=aeonxminio
AWS_SECRET_ACCESS_KEY=aeonxminio_secret
AWS_STORAGE_BUCKET_NAME=aeonx-documents
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_PATH_STYLE=true
# The host browsers should fetch documents from. Locally this must be the
# host-visible MinIO address, not the in-network one the API talks to.
AWS_S3_CUSTOM_DOMAIN=localhost:9000/aeonx-documents
# Local MinIO is plain http; a real bucket/CloudFront is https.
AWS_S3_URL_PROTOCOL=http:
# Production: a CloudFront distribution in front of the bucket
# AWS_S3_CUSTOM_DOMAIN=docs.aeonx.digital

# ---- CORS (origins allowed to read the public API)
CORS_ALLOW_ALL_ORIGINS=true
# Production: lock this down instead
# CORS_ALLOW_ALL_ORIGINS=false
# CORS_ALLOWED_ORIGINS=https://aeonx.digital,https://www.aeonx.digital
# CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.vercel\.app$

# ---- Convenience: auto-create an admin on a fresh local stack.
# Leave these unset in production and run createsuperuser by hand.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@aeonx.local
DJANGO_SUPERUSER_PASSWORD=aeonx-local-admin-2026
