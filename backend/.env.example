# Copy to .env and adjust. Nothing here is read from anywhere else --
# the same image runs locally and on AWS with only this file differing.

# ---- Django
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,api
DJANGO_TIME_ZONE=Asia/Kolkata
# Production only: scheme-qualified origins that POST to the admin
# DJANGO_CSRF_TRUSTED_ORIGINS=https://admin.aeonx.digital

# ---- Postgres
POSTGRES_DB=aeonx
POSTGRES_USER=aeonx
POSTGRES_PASSWORD=aeonx
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Object storage
# Local: MinIO. Production: delete AWS_S3_ENDPOINT_URL and AWS_S3_PATH_STYLE,
# then use a real bucket + an IAM role on the instance (no keys in the file).
USE_S3=true
AWS_ACCESS_KEY_ID=aeonxminio
AWS_SECRET_ACCESS_KEY=aeonxminio_secret
AWS_STORAGE_BUCKET_NAME=aeonx-documents
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_PATH_STYLE=true
# The host browsers should fetch documents from. Locally this must be the
# host-visible MinIO address, not the in-network one the API talks to.
AWS_S3_CUSTOM_DOMAIN=localhost:9000/aeonx-documents
# Local MinIO is plain http; a real bucket/CloudFront is https.
AWS_S3_URL_PROTOCOL=http:
# Production: a CloudFront distribution in front of the bucket
# AWS_S3_CUSTOM_DOMAIN=docs.aeonx.digital

# ---- CORS (origins allowed to read the public API)
CORS_ALLOW_ALL_ORIGINS=true   # local only; production shares one CloudFront origin, set false
# Production: lock this down instead
# CORS_ALLOW_ALL_ORIGINS=false
# CORS_ALLOWED_ORIGINS=https://aeonx.digital,https://www.aeonx.digital
# CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.vercel\.app$

# ---- Convenience: auto-create an admin on a fresh local stack.
# Leave these unset in production and run createsuperuser by hand.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@aeonx.local
DJANGO_SUPERUSER_PASSWORD=aeonx-local-admin-2026

# ---- Contact form
# Local/staging: console backend prints the email to the container's stdout
# instead of sending it -- check `docker compose logs api` after a test submit.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=sales@aeonx.digital
CONTACT_NOTIFY_EMAIL=sales@aeonx.digital
CONTACT_THROTTLE_RATE=10/hour

# ---- Production notes (see backend/README.md "Deploying to AWS")
# Everything above is the LOCAL stack. On AWS the differences that matter:
#   DJANGO_DEBUG=false
#   DJANGO_SECRET_KEY=<50+ random chars, never the dev one>
#   DJANGO_ALLOWED_HOSTS=dhixs8fi5fryo.cloudfront.net,<ec2-public-dns>,13.204.150.143
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://dhixs8fi5fryo.cloudfront.net
#   POSTGRES_HOST=<rds endpoint>   POSTGRES_DB=aeonx   POSTGRES_USER/PASSWORD=<rds>
#   AWS_STORAGE_BUCKET_NAME=aeonx-website-file-hosting
#   AWS_S3_CUSTOM_DOMAIN=dhixs8fi5fryo.cloudfront.net
#   delete AWS_S3_ENDPOINT_URL, AWS_S3_PATH_STYLE and AWS_S3_URL_PROTOCOL (MinIO only)
#   leave AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY EMPTY so boto3 uses the instance role
#   EMAIL_BACKEND=django_ses.SESBackend      (NOT the console backend, and NOT SMTP)
#   CORS_ALLOW_ALL_ORIGINS=false, both CORS lists empty (same-origin, CORS unused)
#   delete every DJANGO_SUPERUSER_* line and run createsuperuser by hand
#   DJANGO_HSTS_SECONDS stays 3600 through cutover, then raise it deliberately
